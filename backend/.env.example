# TerraSense — Backend Environment Configuration Example
# Copy to .env and configure as needed.

APP_NAME=TerraSense API
ENVIRONMENT=production
DEBUG=false

# Rainfall Provider (default: open-meteo, free without API key)
RAINFALL_PROVIDER=open-meteo
RAINFALL_API_KEY=
CACHE_TTL_SECONDS=900

# Server settings
HOST=0.0.0.0
PORT=8000

# Firebase Cloud Messaging (FCM) Push Notifications (Server-Side Only)
# Note: google-services.json is for Android only.
# Server requires a Firebase Admin Service Account key (kept private, NEVER committed to git).
FIREBASE_PROJECT_ID=teraa-sense
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Or specify inline raw JSON string (ideal for containerized deployments):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
